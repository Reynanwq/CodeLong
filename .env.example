# Copie para .env e ajuste os valores. Nao versione o .env.

# Secret HMAC do JWT. Use pelo menos 32 bytes aleatorios.
# Exemplo de geracao: openssl rand -base64 48
CODELONG_JWT_SECRET=

# Expiracao do token (ex.: 30m, 2h, 8h)
CODELONG_JWT_EXPIRATION=2h

# Origens permitidas para CORS (separadas por virgula)
CODELONG_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin inicial criado no bootstrap (deixe vazio para nao criar)
CODELONG_ADMIN_USERNAME=admin
CODELONG_ADMIN_PASSWORD=